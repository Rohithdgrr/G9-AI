{
  "identifier": "default",
  "description": "Default capabilities for Ganesha",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "dialog:default",
    "notification:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
